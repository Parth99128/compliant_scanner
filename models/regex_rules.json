{"$comment": "Regex rule definitions versioned for the CPU extraction baseline (mirrors app/services/extraction.py).", "mrp": "(?:MRP|M\\.?R\\.?P\\.?)\\s*(?:Rs\\.?|INR|\\u20b9)?\\s*[:\\-]?\\s*([\\d,]+(?:\\.\\d{1,2})?)", "net_qty": "net\\s*(?:q?t[yl]|quantity|wt|weight|vol|content)[^\\d]*([\\d.,]+)\\s*(kg|g|mg|ml|l|litre?s?|cm|m|nos?|pcs?|pc)\\b", "mfg": "(?:mfg|mtg|manufactured|packed|mfd|pkd)[^\\d]*(\\d{1,2}[/\\-.]\\d{1,2}[/\\-.]\\d{2,4}|\\d{4}[/\\-.]\\d{4})", "care": "(?:customer\\s*care|consumer\\s*care|helpline|toll\\s*free)", "origin": "(?:country\\s*of\\s*origin|made\\s*in)\\s*[:\\-]?\\s*([A-Za-z ]{2,30})"}
