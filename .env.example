DATABASE_URL=postgresql+psycopg2://scanner:scanner@db:5432/scanner
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
MAX_UPLOAD_MB=10
CLOUD_VISION_ENABLED=false
# Optional Gemini/Gemma explanations (off by default; core pipeline never needs a key).
# A Google AI Studio key works for both. For Gemma use e.g. LLM_MODEL=gemma-3-27b-it.
LLM_PROVIDER=off
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash
# Optional Florence-2 VLM second-opinion OCR, local CPU (downloads ~1.5 GB on first use).
FLORENCE_ENABLED=false
FLORENCE_MODEL=microsoft/Florence-2-base
