DATABASE_URL=postgresql+psycopg2://scanner:scanner@db:5432/scanner
# REQUIRED: generate a strong secret before first deploy, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Then set JWT_SECRET=<hex> in .env. Compose refuses to start without it.
# POSTGRES_PASSWORD should also be changed for any non-local deploy.
JWT_SECRET=replace-me-generate-with-secrets-token-hex-32
JWT_ALGORITHM=HS256
MAX_UPLOAD_MB=10
CLOUD_VISION_ENABLED=false
# Optional Gemini/Gemma explanations (off by default; core pipeline never needs a key).
# A Google AI Studio key works for both. gemini-2.0-flash is retired; use a
# -latest alias. gemma-4 small models echo prompts instead of emitting JSON —
# use gemini-flash-lite-latest (or better) for structured extraction.
LLM_PROVIDER=off
GEMINI_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
# Optional Florence-2 VLM second-opinion OCR, local CPU (downloads ~1.5 GB on first use).
FLORENCE_ENABLED=false
FLORENCE_MODEL=microsoft/Florence-2-base
# Optional TrOCR line re-reader, local CPU transformer (downloads ~0.4 GB on first use).
# Re-reads low-confidence OCR lines only; billed in seconds per scan on CPU.
TROCR_ENABLED=false
TROCR_MODEL=microsoft/trocr-small-printed
# Optional generic local VLM reader, local CPU (downloads ~0.5 GB on first use).
# Slow (~30-60 s/scan); only consulted when enabled AND the read is weak.
VLM_ENABLED=false
VLM_MODEL=HuggingFaceTB/SmolVLM-256M-Instruct
# Optional Gemini structured extraction for weak reads (billed per call).
# Uses LLM_PROVIDER + GEMINI_API_KEY above; gated to low-confidence scans.
# Optional Open Food Facts barcode cross-check (public data, fails silently).
OFF_LOOKUP_ENABLED=true
